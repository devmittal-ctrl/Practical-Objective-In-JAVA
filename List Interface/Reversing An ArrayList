import java.util.*;
public class zolo{
    public static void main(String[]args){
        //reversing an arraylist 
        var list=new ArrayList<Integer>();
        list.add(1);
        list.add(2);
        list.add(3);
        list.add(4);
        list.add(5);
        System.out.println(list); // og list
        int f=0,i=0;
        int l=list.size()-1;
        while(i<=l/2){
            int temp=list.get(l);
            list.set(l,list.get(f));
            list.set(f,temp);
            l--;f++;i++;
        }
        System.out.println(list);
    }
}

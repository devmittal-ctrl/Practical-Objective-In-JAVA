class StudentRecord{
    private String name;
    private String studentId;
    private int marks;
    StudentRecord(){
        System.err.println("name and student id must not be equal to null so,");
        name="abc";
        studentId="25csuxxx";
        System.out.println("name : "+name+" | student id : "+studentId);
    }
    StudentRecord(int marks,String name,String studentId){
        this.marks=marks;
        this.name=name;
        this.studentId=studentId;
        if(marks<=0) System.err.println("enter a valid marks");
        else System.out.println("marks: "+marks+" | name : "+name+" | student id is : "+studentId);

    }
    String getname(){
        return name;
    }
    int getmarks(){
        if(marks>=0 || marks<=100) return marks;
        else return 0;
    }
    String getstudentID(){
        return studentId;
    }
    boolean ispassed(StudentRecord s){
        if(marks>=33) return true;
        if(marks<=0) return false;
        else return false;
    }
    String getClassification(StudentRecord s){
        if(marks<=100 && marks>90) return "Outstanding";
        else if(marks<=90 && marks>70) return "Excellent";
        else if(marks<=70 && marks>40) return "Passed";
        else if(marks<=0) return "Nope";
        else return "Fail";


    }
    @Override
    public String toString(){
        if(marks<=0) return "Can't Display";
        else return "StudentRecord{Details of the student is : "+marks+"|"+name+"|"+studentId+"}";
    }
}

    }
    StudentRecord(int marks,String name,String studentId){
        this.marks=marks;
        this.name=name;
        this.studentId=studentId;
        System.out.println("marks: "+marks+" | name : "+name+" | student id is : "+studentId);
    }
    void getname(String name){
        this.name=name;
    }
    void getmarks(int marks){
        this.marks=marks;
    }
    void getstudentID(String studentID){
        this.studentId=studentID;
    }
    boolean ispassed(StudentRecord s){
        if(marks>=33) return true;
        else return false;
    }
    String getClassification(StudentRecord s){
        if(marks<=100 && marks>90) return "Outstanding";
        if(marks<=90 && marks>70) return "Excellent";
        if(marks<=70 && marks>40) return "Passed";
        else return "Fail";

    }

abstract class Shape{
    private double length;
    abstract double area();
    abstract double perimeter();
    Shape(double length){
        if(length<=0){
            System.out.println("enter a valid syntax");
            return;
        }
        else this.length=length;
    }
    public double get_length(){
        return length;
    }
    public String toString(){
        return "length dimension id : "+length;
    }

}
class rectangle extends Shape{
    private double width;
    rectangle(double length,double width){
        super(length);
        if(width<=0){
            System.out.println("enter a valid syntax");
            return;
        }
        this.width=width;
    }
    void name_class(){
        System.out.println("Rectangle class is being used ");
    }
    @Override
    double area(){
        return get_length()*width;
    }
    @Override
    double perimeter(){
        return (2*(width+get_length()));
    }
    @Override
    public String toString(){
        return "the perimter of rectangle is : "+perimeter()+"\nthe area of rectangle is : "+area();
    }
}
class circle extends Shape{
    void fun(){
        System.out.println("Circle class is being used ");
    }
    circle(double length){
        super(length);
    }
    @Override
    double area(){
        return (3.14*get_length()*get_length());
    }
    @Override
    double perimeter(){
        return (6.28*get_length());
    }
    @Override
    public String toString(){
        return "the circunfernce of circle  is : "+perimeter()+"\nthe area of circle is : "+area();

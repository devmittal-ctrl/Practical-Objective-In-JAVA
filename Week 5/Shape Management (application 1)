}
class triangle extends Shape{
    private double heigth;
    private double heigth1;
    triangle(double heigth,double length,double heigth1){
        super(length);
        if(heigth<=0){
            System.err.println("enter a valid syntax");
            return;
        }
        this.heigth=heigth;
        this.heigth1=heigth1;
    }
    @Override
    double area(){
        return ((get_length()*heigth)/2);
    }
    @Override
    double perimeter(){
        return (heigth1+heigth+get_length());
    }
    @Override
    public String toString(){
        return "the perimeter of triangle  is : "+perimeter()+"\nthe area of triangle is : "+area();
    }
}

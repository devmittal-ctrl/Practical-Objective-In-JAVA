class PayrollProcessor {
    private Payable[] payables;
    private int size;
    public PayrollProcessor(int capacity) {
        payables = new Payable[capacity];
    }
    public void addPayable(Payable payable) {
        if (size < payables.length) {
            payables[size] = payable;
            size++;
            System.out.println("Payment object added successfully.");
        } else {
            System.out.println("Payroll processor is full.");
        }
    }
    public double calculateTotalPayment() {
        double total = 0;
        for (int i = 0; i < size; i++) {
            total += payables[i].payment_amount();
        }
        return total;
    }
    public Payable Largest_Payment() {
        if (size == 0) {
            return;
        }
        Payable largest = payables[0];
        for (int i = 1; i < size; i++) {
            if (payables[i].calculatePayment()
                    > largest.calculatePayment()) {
                largest = payables[i];
            }
        }
        return largest;
    }

interface payable{
    int payment_amount();
}
abstract class employee implements payable{
    protected String employee_id;
    protected String employee_name;
    employee(String employee_id,String employee_name){
        if(employee_name.trim()==null | employee_id.trim()==null){
            System.err.println("enter a valid syntax");
            return;
        }
        this.employee_id=employee_id;
        this.employee_name=employee_name;
    }
    public String get_employee_id(){
        return employee_id;
    }
    public String get_employee_name(){
        return employee_name;
    }
    @Override
    public String toString(){
        return "Employee name : "+employee_name+"\nEmployee id : "+employee_id;
    }
}
class salried_employee extends employee{
    private int salary;
    salried_employee(String employee_id, String employee_name,int salary){
        super(employee_id, employee_name);
        if(salary<=0){
            System.err.println("nope this is not possible");
